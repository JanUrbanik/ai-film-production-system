{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shot_packet.schema.json",
  "title": "FilmFactoryShotPacket",
  "type": "object",
  "required": [
    "shot_id",
    "mode",
    "duration_target",
    "aspect",
    "resolution",
    "prompt",
    "bible_pins",
    "status"
  ],
  "additionalProperties": true,
  "properties": {
    "shot_id": { "type": "string", "pattern": "^S[0-9A-Za-z_-]+$" },
    "sequence": { "type": "string" },
    "mode": {
      "type": "string",
      "enum": ["i2v", "r2v", "t2v", "extend", "edit"]
    },
    "model_video": {
      "type": "string",
      "default": "grok-imagine-video-1.5"
    },
    "model_image": {
      "type": "string",
      "default": "imagine-image-2.0-quality",
      "description": "Consumer Image 2.0 Quality label by default. API overflow: grok-imagine-image-quality until Image 2.0 API id ships."
    },
    "image_surface": {
      "type": "string",
      "enum": ["consumer_imagine_2.0", "api_image_quality", "api_image_standard"],
      "default": "consumer_imagine_2.0"
    },
    "duration_target": { "type": "integer", "minimum": 1, "maximum": 15 },
    "duration_policy": {
      "type": "string",
      "enum": ["standard_8s_cap", "api_max_15s"],
      "default": "standard_8s_cap",
      "description": "K-SHOT-SCRIPT-001 conversion path prefers ≤8s; api_max_15s only if Director overrides."
    },
    "refs": {
      "type": "array",
      "description": "Pipeline REFS IDs e.g. CHAR_001, LOC_002/DUSK — never embedded in prompt.full_text",
      "items": { "type": "string" }
    },
    "screen_direction": { "type": ["string", "null"] },
    "lipsync": { "type": "boolean", "default": false },
    "dialogue": { "type": ["string", "null"] },
    "dialogue_delivery": { "type": ["string", "null"] },
    "vo_segment": { "type": ["string", "null"] },
    "framing": { "type": ["string", "null"] },
    "lens": { "type": ["string", "null"] },
    "fov_deg": {
      "type": ["number", "null"],
      "description": "Primary optics control. mm remains a human label."
    },
    "chain_from_previous": {
      "type": "boolean",
      "default": false,
      "description": "Derived from junction_type. Continuous=true."
    },
    "junction_type": {
      "type": ["string", "null"],
      "enum": ["Continuous", "Scene_change", "Temporal_ellipsis", null]
    },
    "first_frame": { "type": ["string", "null"] },
    "body": { "type": ["string", "null"] },
    "gaze": { "type": ["string", "null"] },
    "physics": { "type": ["string", "null"] },
    "master_prompt": { "type": ["string", "null"] },
    "attachment_convention_id": { "type": ["string", "null"] },
    "gen_prompt_lint": {
      "type": "string",
      "enum": ["pass", "fail", "unchecked"],
      "default": "unchecked",
      "description": "fail if full_text contains brackets or TYPE_ID tokens"
    },
    "aspect": {
      "type": "string",
      "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]
    },
    "resolution": { "type": "string", "enum": ["480p", "720p", "1080p"] },
    "source_still": { "type": ["string", "null"] },
    "source_video": { "type": ["string", "null"] },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path"],
        "properties": {
          "role": { "type": "string" },
          "path": { "type": "string" },
          "tag": { "type": "string", "description": "e.g. IMAGE_1" }
        }
      }
    },
    "bible_pins": {
      "type": "object",
      "required": ["style"],
      "properties": {
        "character": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "array", "items": { "type": "string" } },
        "props": { "type": "array", "items": { "type": "string" } },
        "wardrobe": { "type": "array", "items": { "type": "string" } },
        "style": { "type": "string" }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["full_text"],
      "description": "full_text MUST equal shot-script GEN_PROMPT: natural language only, zero pipeline IDs",
      "properties": {
        "identity_block": { "type": "string", "description": "Optional assembly aid; strip IDs before merge into full_text" },
        "env_block": { "type": "string" },
        "prop_block": { "type": "string" },
        "camera": { "type": "string" },
        "action": { "type": "string" },
        "audio_note": { "type": "string" },
        "negatives": { "type": "string" },
        "full_text": { "type": "string" }
      }
    },
    "takes_planned": { "type": "integer", "minimum": 1, "default": 4 },
    "adapter": {
      "type": ["string", "null"],
      "description": "null unless Director approved failure-class adapter"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "gen",
        "qc",
        "pass",
        "fail",
        "landed",
        "regen_requested"
      ],
      "description": "Additive statuses: landed = take on disk not yet R9 PASS; regen_requested = Director fault queued. Unknown future keys must not be stripped by validators."
    },
    "last_fault": {
      "type": ["object", "null"],
      "description": "Director reject note; additive. Do not strip."
    },
    "cost_estimate_usd": { "type": ["number", "null"] }
  }
}
